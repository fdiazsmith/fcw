{
  "name": "fcw",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run build -w packages/server && npm run dev -w packages/server & npm run dev -w packages/frontend"
  }
}
