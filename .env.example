# Claude API key for streaming responses
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Server port (default: 8080)
PORT=8080

# Document storage directory (default: ~/.fcw/documents/)
FCW_STORAGE_DIR=

# Frontend WebSocket URL (set in packages/frontend/.env.local)
# VITE_WS_URL=ws://localhost:8080

# Enable demo mode (no server needed, loads sample graph)
# VITE_DEMO=true
